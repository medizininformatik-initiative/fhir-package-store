{"resourceType":"CodeSystem","id":"KBV-CS-SFHIR-KBV-STICHPROBE","url":"https://fhir.kbv.de/CodeSystem/KBV_CS_SFHIR_KBV_STICHPROBE","identifier":[{"system":"urn:ietf:rfc:3986","value":"urn:oid:1.2.276.0.76.5.113"}],"version":"1.00","name":"KBV_CS_SFHIR_KBV_STICHPROBE","status":"active","date":"2004-10-01","publisher":"Kassenärztliche Bundesvereinigung","contact":[{"telecom":[{"system":"url","value":"http://www.kbv.de"}]}],"description":"Stichprobenzuordnung: wird für den Risikostrukturausgleich (RSA) verwendet; gibt an ob ein Versicherter an einer bestimmten Stichprobe teilnimmt. Die Angabe ist auf der EGK vorhanden und auf der KVK Teil des Feldes: Versichertenstatus (2. Stelle).","copyright":"Kassenärztliche Bundesvereinigung","caseSensitive":true,"content":"complete","concept":[{"code":"0","display":"Versicherter nimmt nicht an der Stichprobe teil"},{"code":"1","display":"weiblich, ohne EU/BU-Rentenbezug"},{"code":"2","display":"männlich, ohne EU/BU-Rentenbezug"},{"code":"3","display":"weiblich mit EU/BU-Rentenbezug"},{"code":"4","display":"männlich mit EU/BU-Rentenbezug"},{"code":"5","display":"weiblich ohne EU/BU-Rentenbezug vor 1900 geboren"},{"code":"6","display":"männlich ohne EU/BU-Rentenbezug vor 1900 geboren"},{"code":"7","display":"weiblich mit EU/BU-Rentenbezug nach 1999 geboren"},{"code":"8","display":"männlich mit EU/BU-Rentenbezug nach 1999 geboren"}]}