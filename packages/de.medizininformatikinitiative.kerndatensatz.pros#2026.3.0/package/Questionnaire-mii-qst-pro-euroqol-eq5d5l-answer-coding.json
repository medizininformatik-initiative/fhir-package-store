oded-vas","code":[{"system":"http://snomed.info/sct","code":"446515003","display":"Health assessment questionnaire score"}],"text":"IHRE GESUNDHEIT HEUTE","_text":{"extension":[{"extension":[{"url":"lang","valueCode":"en"},{"url":"content","valueString":"YOUR HEALTH TODAY"}],"url":"http://hl7.org/fhir/StructureDefinition/translation"}]},"type":"integer","required":true,"repeats":false,"initial":[{"valueInteger":999}]}]}