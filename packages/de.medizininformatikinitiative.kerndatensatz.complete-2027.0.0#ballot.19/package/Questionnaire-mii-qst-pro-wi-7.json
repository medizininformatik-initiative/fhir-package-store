    {
      "code": "wi-7",
      "system": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/CodeSystem/mii-cs-pro-questionnaire-catalogue",
      "display": "Whiteley-7 (Seven-item scale for hypochondriasis and somatization, Fink et al. 1999)"
    }
  ],
  "item": [
    {
      "linkId": "wi7-intro",
      "type": "display",
      "text": "The following questions are about your physical health:",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "In den nächsten Fragen geht es um Ihren körperlichen Gesundheitszustand:"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      }
    },
    {
      "answerOption": [
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 0
              }
            ],
            "code": "373067005",
            "system": "http://snomed.info/sct",
            "display": "No"
          }
        },
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 1
              }
            ],
            "code": "373066001",
            "system": "http://snomed.info/sct",
            "display": "Yes"
          }
        }
      ],
      "linkId": "wi7-q01",
      "type": "choice",
      "prefix": "1",
      "text": "Do you think there is something seriously wrong with your body?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Denken Sie, dass mit Ihrem Körper ernsthaft etwas nicht in Ordnung ist?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      }
    },
    {
      "answerOption": [
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 0
              }
            ],
            "code": "373067005",
            "system": "http://snomed.info/sct",
            "display": "No"
          }
        },
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 1
              }
            ],
            "code": "373066001",
            "system": "http://snomed.info/sct",
            "display": "Yes"
          }
        }
      ],
      "linkId": "wi7-q02",
      "type": "choice",
      "prefix": "2",
      "text": "Do you worry a lot about your health?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Machen Sie sich viel Sorgen um Ihre Gesundheit?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      }
    },
    {
      "answerOption": [
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 0
              }
            ],
            "code": "373067005",
            "system": "http://snomed.info/sct",
            "display": "No"
          }
        },
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 1
              }
            ],
            "code": "373066001",
            "system": "http://snomed.info/sct",
            "display": "Yes"
          }
        }
      ],
      "linkId": "wi7-q03",
      "type": "choice",
      "prefix": "3",
      "text": "Is it hard for you to believe the doctor when he tells you there is nothing to worry about?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Können Sie der Ärztin/dem Arzt nur schwer glauben, wenn sie/er sagt, dass kein Grund zur Besorgnis besteht?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      }
    },
    {
      "answerOption": [
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 0
              }
            ],
            "code": "373067005",
            "system": "http://snomed.info/sct",
            "display": "No"
          }
        },
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 1
              }
            ],
            "code": "373066001",
            "system": "http://snomed.info/sct",
            "display": "Yes"
          }
        }
      ],
      "linkId": "wi7-q04",
      "type": "choice",
      "prefix": "4",
      "text": "Do you often worry about the possibility that you have a serious illness?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Machen Sie sich oft Sorgen, möglicherweise eine ernsthafte Krankheit zu haben?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      }
    },
    {
      "answerOption": [
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 0
              }
            ],
            "code": "373067005",
            "system": "http://snomed.info/sct",
            "display": "No"
          }
        },
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 1
              }
            ],
            "code": "373066001",
            "system": "http://snomed.info/sct",
            "display": "Yes"
          }
        }
      ],
      "linkId": "wi7-q05",
      "type": "choice",
      "prefix": "5",
      "text": "Are you bothered by many different pains and aches?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Werden Sie durch eine Vielzahl von Schmerzen geplagt?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      }
    },
    {
      "answerOption": [
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 0
              }
            ],
            "code": "373067005",
            "system": "http://snomed.info/sct",
            "display": "No"
          }
        },
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 1
              }
            ],
            "code": "373066001",
            "system": "http://snomed.info/sct",
            "display": "Yes"
          }
        }
      ],
      "linkId": "wi7-q06",
      "type": "choice",
      "prefix": "6",
      "text": "If disease is brought to your attention (e.g., on TV, radio, the newspapers, or by someone you know), do you worry about getting it yourself?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Wenn Sie auf eine Krankheit aufmerksam gemacht werden (durch Fernsehen, Zeitung oder einen Bekannten), machen Sie sich dann Sorgen, dass Sie diese Krankheit auch bekommen?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      }
    },
    {
      "answerOption": [
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 0
              }
            ],
            "code": "373067005",
            "system": "http://snomed.info/sct",
            "display": "No"
          }
        },
        {
          "valueCoding": {
            "extension": [
              {
                "url": "http://hl7.org/fhir/StructureDefinition/itemWeight",
                "valueDecimal": 1
              }
            ],
            "code": "373066001",
            "system": "http://snomed.info/sct",
            "display": "Yes"
          }
        }
      ],
      "linkId": "wi7-q07",
      "type": "choice",
      "prefix": "7",
      "text": "Do you find that you are bothered by many different symptoms?",
      "_text": {
        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Finden Sie, dass Sie von einer Vielzahl unterschiedlicher Symptome geplagt werden?"
              }
            ],
            "url": "http://hl7.org/fhir/StructureDefinition/translation"
          }
        ]
      }
    },
    {
      "code": [
        {
          "code": "wi-7-total",
          "system": "https://www.medizininformatik-initiative.de/fhir/ext/modul-pro/CodeSystem/mii-cs-pro-score-catalogue",
          "display": "Whiteley-7 Total Score (0-7)"
        }
      ],
