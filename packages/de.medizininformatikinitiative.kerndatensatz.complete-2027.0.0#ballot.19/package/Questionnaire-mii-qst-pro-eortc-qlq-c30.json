        "extension": [
          {
            "extension": [
              {
                "url": "lang",
                "valueCode": "de"
              },
              {
                "url": "content",
                "valueString": "Brauchen Sie Hilfe beim Essen, Anziehen, Waschen oder Benutzen der Toilette?"
